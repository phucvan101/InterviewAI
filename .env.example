# App
VITE_APP_NAME=Vue3 Template
VITE_APP_URL=http://localhost:3000

# API
# Use same-origin in FE and proxy /api to BE in Vite config
VITE_API_BASE_URL=/api

# WebRTC Signaling (replace with your server)
VITE_SIGNALING_URL=ws://localhost:4000

# TURN Server (for production WebRTC behind NAT)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
